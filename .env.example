# Copier en .env.local et remplir. Ne jamais commiter .env.local.
# Seules les variables NEXT_PUBLIC_* sont exposées au navigateur : n'y mettre que des valeurs publiques.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
# Clé "publishable" (sb_publishable_...) : publique, l'accès est filtré par RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# La clé service role n'est PAS utilisée par le site : seules les Edge Functions
# l'utilisent (injectée automatiquement par Supabase sous SUPABASE_SERVICE_ROLE_KEY).

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Alpha Vantage ---
ALPHA_VANTAGE_API_KEY=

# --- SEC EDGAR : "Prénom Nom email@domaine" ---
SEC_USER_AGENT=

# --- Interne ---
# Secret partagé entre le serveur Next.js, les Edge Functions et pg_cron (64 caractères hex)
FUNCTIONS_SECRET=
# Emails des administrateurs (séparés par des virgules)
ADMIN_EMAILS=
